*.env
*.env.*
!.env.example
keys.yaml
keys*.cfg
.api_key
private/

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# PyInstaller / Packaging
*.manifest
*.spec

# Python Tooling & Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.pyre/
.hypothesis/
.cache/
.tox/
.nox/

# Coverage & Testing Reports
htmlcov/
.coverage
.coverage.*
coverage.xml
cov.xml
nosetests.xml
*.cover
*.py,cover

# Jupyter & IPython
.ipynb_checkpoints
profile_default/
ipython_config.py

# ------------------------------------------------------------------------------
# Node.js, Next.js & Frontend (apps/web & others)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js & Build outputs
.next/
out/
.turbo/
*.tsbuildinfo
website/frontend/node_modules
website/frontend/package-lock.json
website/frontend/.pnp
website/frontend/coverage
website/frontend/build
*.pnp.js

