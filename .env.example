# ======================================================
# Bug Reproducer Assistant Example Environment Configuration
# ======================================================
# Copy this file to `.env` and fill in your actual API keys.
# DO NOT commit `.env` containing real secret keys to public Git.

# ------------------------------------------------------
# Groq LLM Provider Configurations (MANDATORY)
# ------------------------------------------------------
# Get your Groq API Key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_CODE=deepseek-r1-distill-llama-70b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=3
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ------------------------------------------------------
# GitHub API Operations (SWE-Agent Adaptation)
# ------------------------------------------------------
# Used for pulling issue metadata, code context, and opening PRs.
# Required scopes: public_repo (or repo for private repos)
GITHUB_TOKEN=your_github_personal_access_token_here

# ------------------------------------------------------
# Application & Worker Settings
# ------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=your_secret_key_here

# ------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------
POSTGRES_USER=bug_assistant
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=bug_reproducer_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bug_assistant:your_postgres_password_here@localhost:5432/bug_reproducer_db

# ------------------------------------------------------
# SWE-Agent Environment & Docker Sandbox Defaults
# ------------------------------------------------------
SWE_AGENT_SANDBOX_TIMEOUT=300
SWE_AGENT_CONTAINER_IMAGE=sweagent/swe-agent:latest
